# Variáveis de ambiente do ReadingFlow (apenas nomes — NUNCA comitar chaves reais)

# Ambiente da aplicação
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provedores externos de catálogo (somente servidor — sem prefixo NEXT_PUBLIC)
GOOGLE_BOOKS_API_KEY=
HARDCOVER_API_TOKEN=
ENABLE_APPLE_BOOKS_COVERS=false
OPEN_LIBRARY_USER_AGENT="ReadingFlow/0.1 (contato@readingflow.app)"

# Limites operacionais e segurança
CATALOG_LOOKUP_TIMEOUT_MS=4000
RATE_LIMIT_MAX_PER_MINUTE=60

# Supabase (Etapa 2 — adiado na fase inicial sem banco de dados)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

