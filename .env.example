# Variáveis de ambiente do ReadingFlow (apenas nomes — NUNCA comitar chaves reais)

# Ambiente da aplicação
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provedores externos de catálogo (somente servidor — sem prefixo NEXT_PUBLIC)
GOOGLE_BOOKS_API_KEY=
HARDCOVER_API_TOKEN=
ENABLE_APPLE_BOOKS_COVERS=false
OPEN_LIBRARY_USER_AGENT="ReadingFlow/0.1 (contato@readingflow.app)"

# Limites operacionais e segurança
CATALOG_LOOKUP_TIMEOUT_MS=4000
RATE_LIMIT_MAX_PER_MINUTE=60

# =============================================================================
# Segurança de Autenticação (credential stuffing, anti-enumeração e logs)
# =============================================================================
# Obrigatório em produção (>= 32 chars aleatórios). NUNCA usar prefixo NEXT_PUBLIC.
AUTH_HMAC_SECRET=
# Opcional: segredo separado para cookie assinado rf_known_device (deriva de AUTH_HMAC_SECRET se omitido)
AUTH_DEVICE_COOKIE_SECRET=

# Proxy reverso confiável (ligar somente atrás de Cloudflare/Vercel/Nginx gerenciado)
AUTH_TRUST_PROXY=0
AUTH_TRUSTED_PROXY_HEADERS=cf-connecting-ip,x-real-ip,x-forwarded-for

# Equalização de tempo de resposta (anti-timing oracle)
AUTH_MIN_RESPONSE_MS=600
AUTH_RESPONSE_JITTER_MS=80

# Política de bloqueio progressivo por conta, IP e modo ataque
AUTH_ACCOUNT_FAIL_THRESHOLD=3
AUTH_ACCOUNT_WINDOW_SEC=900
AUTH_LOCKOUT_STEPS_SEC=60,300,900,3600
AUTH_LOCKOUT_DECAY_HOURS=24
AUTH_IP_FAIL_THRESHOLD=10
AUTH_IP_WINDOW_SEC=300
AUTH_PAIR_FAIL_THRESHOLD=3
AUTH_PAIR_WINDOW_SEC=900
AUTH_ATTACK_MODE_DISTINCT_ACCOUNTS=8
AUTH_ATTACK_MODE_MAX_IPS=5
AUTH_ATTACK_MODE_WINDOW_SEC=300
AUTH_ATTACK_MODE_DURATION_SEC=600

# CAPTCHA (turnstile | hcaptcha | mock | none)
AUTH_CAPTCHA_PROVIDER=none
AUTH_CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
AUTH_CAPTCHA_STEP_BEFORE_LOCKOUT=2

# Verificação de senhas vazadas (k-anonymity HIBP, somente servidor)
AUTH_HIBP_CHECK_ENABLED=true
AUTH_HIBP_TIMEOUT_MS=2500

# Parâmetros Argon2id para segredos próprios do app (mínimos OWASP: m>=19456 KiB, t>=2, p>=1)
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_PASSES=6
AUTH_ARGON2_PARALLELISM=1

# Confirmação de e-mail obrigatória no cadastro (ligar em staging/produção)
AUTH_REQUIRE_EMAIL_CONFIRMATION=false

# Retenção de logs de auditoria (LGPD)
AUTH_LOG_RETENTION_DAYS=90

# Supabase (Etapa 2 — adiado na fase inicial sem banco de dados)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
