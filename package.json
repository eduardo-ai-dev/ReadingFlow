{
  "name": "readingflow",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca pessoal digital para livros físicos, e-books e audiobooks (Release R0 — 2D)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:contrast && npm run check:images && next build",
    "start": "next start",
    "check:contrast": "node scripts/verify-theme-contrast.mjs",
    "check:contrast:rendered": "node scripts/verify-theme-contrast.mjs --rendered",
    "check:images": "node scripts/check-images.mjs",
    "check:middleware": "node scripts/check-no-middleware.mjs",
    "lint": "npm run check:middleware && eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "loadtest:seed": "node loadtest/seed.mjs",
    "loadtest:http": "node loadtest/run-http-load.mjs",
    "loadtest:smoke": "node loadtest/smoke.mjs",
    "loadtest:cleanup": "node loadtest/cleanup.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@zxing/browser": "^0.2.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.166.0"
  }
}
