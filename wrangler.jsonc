{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "readingflow",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"DEMO_ENABLED": "true"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "readingflow-db",
			"database_id": "a0bd375a-0eb3-4e37-9d95-28866689411e",
			"migrations_dir": "migrations"
		}
	]
}
